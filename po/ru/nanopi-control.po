msgstr "Не требуется"

msgid "The system is running from an SD card"
msgstr "Система загружена с SD-карты"

msgid "The system is not running from an SD card"
msgstr "Система загружена не с SD-карты"

msgid "The system is running from an SD card and can be prepared for transfer to internal eMMC."
msgstr "Система загружена с SD-карты и может быть подготовлена к переносу во внутреннюю eMMC."

msgid "Open transfer assistant"
msgstr "Открыть мастер переноса"

msgid "System information"
msgstr "Информация о системе"

msgid "Board"
msgstr "Плата"

msgid "OpenWrt version"
msgstr "Версия OpenWrt"

msgid "Kernel version"
msgstr "Версия ядра"

msgid "WrtPilot version"
msgstr "Версия WrtPilot"

msgid "Active IPv4 addresses"
msgstr "Активные IPv4-адреса"

msgid "No active IPv4 addresses"
msgstr "Нет активных IPv4-адресов"

msgid "Storage information"
msgstr "Информация о накопителях"

msgid "Root device"
msgstr "Системный накопитель"

msgid "Root partition"
msgstr "Системный раздел"

msgid "Root filesystem"
msgstr "Файловая система"

msgid "Root partition size"
msgstr "Размер системного раздела"

msgid "Root partition available"
msgstr "Свободно на системном разделе"

msgid "Refresh"
msgstr "Обновить"

msgid "Offline assistant for transferring the current OpenWrt installation from an SD card to internal eMMC."
msgstr "Автономный мастер переноса текущей установки OpenWrt с SD-карты во внутреннюю eMMC."

msgid "Transfer is unavailable because the system is not running from an SD card or internal eMMC was not detected."
msgstr "Перенос недоступен: система загружена не с SD-карты либо внутренняя eMMC не обнаружена."

msgid "Return to overview"
msgstr "Вернуться к обзору"

msgid "Step %d"
msgstr "Этап %d"

msgid "Preflight check"
msgstr "Предварительная проверка"

msgid "Verify the board, source system and target eMMC."
msgstr "Проверка платы, исходной системы и целевой eMMC."

msgid "Copy system"
msgstr "Копирование системы"

msgid "Prepare eMMC and transfer the current OpenWrt state."
msgstr "Подготовка eMMC и перенос текущего состояния OpenWrt."

msgid "Boot from eMMC"
msgstr "Загрузка с eMMC"

msgid "Power off, remove the SD card and start the device."
msgstr "Выключение, извлечение SD-карты и запуск устройства."

msgid "Expand partition"
msgstr "Расширение раздела"

msgid "Use all available internal storage after verification."
msgstr "Использование всей внутренней памяти после проверки."

msgid "No changes are being made yet. "
msgstr "Изменения пока не выполняются. "

msgid "The current development version implements diagnostics and the assistant interface. Destructive copy operations will be enabled only after hardware-level tests."
msgstr "Текущая версия реализует диагностику и интерфейс мастера. Операции копирования будут включены только после аппаратного тестирования."

msgid "Readiness check"
msgstr "Проверка готовности"

msgid "Device model"
msgstr "Модель устройства"

msgid "Target storage"
msgstr "Целевой накопитель"

msgid "Filesystem"
msgstr "Файловая система"

msgid "Run check again"
msgstr "Повторить проверку"

msgid "Start transfer"
msgstr "Начать перенос"

msgid "Copy engine is not enabled in this version"
msgstr "Механизм копирования ещё не включён в этой версии"

msgid "Transfer the current OpenWrt installation, settings and WrtPilot from the SD card to internal eMMC without downloading another firmware image."
msgstr "Перенос текущей установки OpenWrt, настроек и WrtPilot с SD-карты во внутреннюю eMMC без скачивания другого образа прошивки."

msgid "Warning: "
msgstr "Внимание: "

msgid "Warning:"
msgstr "Внимание:"

msgid "Unsupported device"
msgstr "Неподдерживаемое устройство"

msgid "The system is not running from SD or eMMC is unavailable"
msgstr "Система загружена не с SD-карты или eMMC недоступна"

msgid "Only ext4 installations are supported"
msgstr "Поддерживаются только установки с ext4"

msgid "Source and target devices are invalid"
msgstr "Исходный и целевой накопители определены неправильно"

msgid "Required system utilities are missing"
msgstr "Отсутствуют необходимые системные утилиты"

msgid "Unexpected OpenWrt partition layout"
msgstr "Обнаружена неподдерживаемая разметка OpenWrt"

msgid "Internal eMMC is too small for the current system"
msgstr "Внутренняя eMMC слишком мала для текущей системы"

msgid "Docker data is stored on a separate mounted filesystem"
msgstr "Данные Docker находятся на отдельно смонтированной файловой системе"

msgid "All existing data on %s will be erased. The SD card is not modified and remains your recovery option."
msgstr "Все имеющиеся данные на %s будут удалены. SD-карта не изменяется и остаётся средством восстановления."

msgid "OpenWrt disk layout"
msgstr "Разметка OpenWrt"

msgid "Supported"
msgstr "Поддерживается"

msgid "Unexpected layout"
msgstr "Неожиданная разметка"

msgid "Required utilities"
msgstr "Необходимые утилиты"

msgid "Installed"
msgstr "Установлены"

msgid "Missing packages"
msgstr "Отсутствуют пакеты"

msgid "Docker state"
msgstr "Состояние Docker"

msgid "Ready"
msgstr "Готово"

msgid "Docker storage must not be mounted"
msgstr "Хранилище Docker не должно быть смонтировано"

msgid "Separate Docker storage is not supported"
msgstr "Отдельно смонтированное хранилище Docker пока не поддерживается"

msgid "Docker and its containers will be migrated; the service will be paused briefly"
msgstr "Docker и контейнеры будут перенесены; сервис будет ненадолго остановлен"

msgid "Docker is not installed"
msgstr "Docker не установлен"

msgid "Target capacity"
msgstr "Объём целевого накопителя"

msgid "Final result"
msgstr "Итоговая проверка"

msgid "Erase eMMC and start transfer"
msgstr "Очистить eMMC и начать перенос"

msgid "To confirm erasing the internal storage, enter its device name exactly: %s"
msgstr "Для подтверждения очистки внутренней памяти точно введите имя устройства: %s"

msgid "After successful copying, shut the NanoPi down, remove the SD card and boot it again. Do not erase the SD card until eMMC boot is verified."
msgstr "После успешного копирования выключите NanoPi, извлеките SD-карту и загрузите устройство снова. Не очищайте SD-карту, пока загрузка с eMMC не будет проверена."

msgid "OpenWrt is now running from internal eMMC. The copied system has been verified and is ready for the final expansion step."
msgstr "OpenWrt загружен с внутренней eMMC. Скопированная система проверена и готова к заключительному расширению."

msgid "This operation extends partition 2 and its ext4 filesystem to all available eMMC space."
msgstr "Операция расширит второй раздел и его файловую систему ext4 на всё доступное пространство eMMC."

msgid "Expand internal storage"
msgstr "Расширить внутреннюю память"

msgid "Confirm boot from eMMC"
msgstr "Подтвердить загрузку с eMMC"

msgid "Confirm"
msgstr "Подтвердить"

msgid "Expand"
msgstr "Расширить"

msgid "Unable to confirm eMMC boot"
msgstr "Не удалось подтвердить загрузку с eMMC"

msgid "Power off, remove the SD card, boot from eMMC and confirm it here."
msgstr "Выключите устройство, извлеките SD-карту, загрузитесь с eMMC и подтвердите загрузку здесь."

msgid "Use all available internal storage after boot confirmation."
msgstr "Использовать всю внутреннюю память после подтверждения загрузки."

msgid "The transfer assistant is not available in the current boot state."
msgstr "Мастер переноса недоступен при текущем состоянии загрузки."

msgid "Waiting"
msgstr "Ожидание"

msgid "Checking…"
msgstr "Проверка…"

msgid "Check for updates"
msgstr "Проверить обновления"

msgid "Update to %s"
msgstr "Обновить до %s"

msgid "Installed version"
msgstr "Установленная версия"

msgid "Latest release"
msgstr "Последний выпуск"

msgid "Not checked"
msgstr "Не проверялось"

msgid "Updates have not been checked"
msgstr "Проверка обновлений ещё не выполнялась"

msgid "WrtPilot updates"
msgstr "Обновления WrtPilot"

msgid "Continue"
msgstr "Продолжить"

msgid "Internal storage expansion is pending"
msgstr "Ожидается расширение внутренней памяти"

msgid "The system is running from eMMC and is ready for final storage expansion."
msgstr "Система загружена с eMMC и готова к заключительному расширению памяти."
