#!/bin/sh

case "$1" in
	list)
		printf '%s\n' '{ "status": {}, "migration_preflight": {}, "migration_status": {}, "migration_start": { "confirmation": "" }, "migration_confirm_boot": { "confirmation": "" }, "migration_expand": { "confirmation": "" }, "migration_erase": { "confirmation": "" }, "sd_expand_info": {}, "sd_expand_status": {}, "sd_expand_start": { "confirmation": "" }, "modules_status": {}, "modules_start": { "module": "", "action": "", "confirmation": "" }, "xui_status": {}, "xui_settings": {}, "xui_settings_save": { "token": "", "exclude4": "", "exclude6": "", "block_ipv6": false }, "xui_panel_save": { "token": "", "port": "", "path": "", "wan": false }, "xui_token_issue": {}, "xui_password_reset": {}, "xui_routing_set": { "enabled": false }, "xui_action": { "action": "" }, "vaultwarden_status": {}, "vaultwarden_action": { "action": "" }, "caddy_status": {}, "caddy_action": { "action": "" }, "update_check": {}, "update_status": {}, "update_start": {} }'
		;;
	call)
		payload="$(cat)"
		case "$2" in
			status)
				exec /usr/libexec/nanopi-control/detect-storage --json
				;;
			migration_preflight)
				exec /usr/libexec/nanopi-control/migration-control preflight
				;;
			migration_status)
				exec /usr/libexec/nanopi-control/migration-control status
				;;
			migration_start)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control start "$confirmation"
				;;
			migration_expand)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control expand "$confirmation"
				;;
			migration_confirm_boot)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control confirm_boot "$confirmation"
				;;
			migration_erase)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control erase "$confirmation"
				;;
			sd_expand_info)
				exec /usr/libexec/nanopi-control/sd-expand-control info
				;;
			sd_expand_status)
				exec /usr/libexec/nanopi-control/sd-expand-control status
				;;
			sd_expand_start)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/sd-expand-control start "$confirmation"
				;;
			modules_status)
				exec /usr/libexec/nanopi-control/modules-control status
				;;
			modules_start)
				module="$(jsonfilter -s "$payload" -e '@.module' 2>/dev/null)"
				action="$(jsonfilter -s "$payload" -e '@.action' 2>/dev/null)"
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				case "$module" in docker|3x-ui|vaultwarden|caddy) ;; *)
					printf '%s\n' '{ "accepted": false, "error": "Неизвестный модуль" }'
					exit 1
					;;
				esac
				exec /usr/libexec/nanopi-control/modules-control start "$module" "$action" "$confirmation"
				;;
			xui_status)
				exec /usr/libexec/nanopi-control/3xui-control status
				;;
			xui_settings)
				exec /usr/libexec/nanopi-control/3xui-control settings
				;;
			xui_settings_save)
				token="$(jsonfilter -s "$payload" -e '@.token' 2>/dev/null)"
				exclude4="$(jsonfilter -s "$payload" -e '@.exclude4' 2>/dev/null)"
				exclude6="$(jsonfilter -s "$payload" -e '@.exclude6' 2>/dev/null)"
				block_ipv6="$(jsonfilter -s "$payload" -e '@.block_ipv6' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/3xui-control save "$token" "$exclude4" "$exclude6" "$block_ipv6"
				;;
			xui_panel_save)
				token="$(jsonfilter -s "$payload" -e '@.token' 2>/dev/null)"
				port="$(jsonfilter -s "$payload" -e '@.port' 2>/dev/null)"
				path="$(jsonfilter -s "$payload" -e '@.path' 2>/dev/null)"
				wan="$(jsonfilter -s "$payload" -e '@.wan' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/3xui-control save-panel "$token" "$port" "$path" "$wan"
				;;
			xui_token_issue)
				exec /usr/libexec/nanopi-control/3xui-control issue-token
				;;
			xui_password_reset)
				exec /usr/libexec/nanopi-control/3xui-control reset-password
				;;
			xui_routing_set)
				enabled="$(jsonfilter -s "$payload" -e '@.enabled' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/3xui-control routing "$enabled"
				;;
			xui_action)
				action="$(jsonfilter -s "$payload" -e '@.action' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/3xui-control action "$action"
				;;
			vaultwarden_status)
				exec /usr/libexec/nanopi-control/vaultwarden-control status
				;;
			vaultwarden_action)
				action="$(jsonfilter -s "$payload" -e '@.action' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/vaultwarden-control action "$action"
				;;
			caddy_status)
				exec /usr/libexec/nanopi-control/caddy-control status
				;;
			caddy_action)
				action="$(jsonfilter -s "$payload" -e '@.action' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/caddy-control action "$action"
				;;
			update_check)
				exec /usr/libexec/nanopi-control/update-control check
				;;
			update_status)
				exec /usr/libexec/nanopi-control/update-control status
				;;
			update_start)
				exec /usr/libexec/nanopi-control/update-control start
				;;
			*)
				printf '%s\n' '{ "error": "Method not found" }'
				exit 1
				;;
		esac
		;;
	*)
		exit 1
		;;
esac
