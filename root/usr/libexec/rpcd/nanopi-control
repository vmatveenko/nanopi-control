#!/bin/sh

case "$1" in
	list)
		printf '%s\n' '{ "status": {}, "migration_preflight": {}, "migration_status": {}, "migration_start": { "confirmation": "" }, "migration_confirm_boot": { "confirmation": "" }, "migration_expand": { "confirmation": "" }, "migration_erase": { "confirmation": "" }, "sd_expand_info": {}, "sd_expand_status": {}, "sd_expand_start": { "confirmation": "" }, "modules_status": {}, "modules_start": { "module": "", "action": "", "confirmation": "" }, "update_check": {}, "update_status": {}, "update_start": {} }'
		;;
	call)
		payload="$(cat)"
		case "$2" in
			status)
				exec /usr/libexec/nanopi-control/detect-storage --json
				;;
			migration_preflight)
				exec /usr/libexec/nanopi-control/migration-control preflight
				;;
			migration_status)
				exec /usr/libexec/nanopi-control/migration-control status
				;;
			migration_start)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control start "$confirmation"
				;;
			migration_expand)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control expand "$confirmation"
				;;
			migration_confirm_boot)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control confirm_boot "$confirmation"
				;;
			migration_erase)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/migration-control erase "$confirmation"
				;;
			sd_expand_info)
				exec /usr/libexec/nanopi-control/sd-expand-control info
				;;
			sd_expand_status)
				exec /usr/libexec/nanopi-control/sd-expand-control status
				;;
			sd_expand_start)
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				exec /usr/libexec/nanopi-control/sd-expand-control start "$confirmation"
				;;
			modules_status)
				exec /usr/libexec/nanopi-control/modules-control status
				;;
			modules_start)
				module="$(jsonfilter -s "$payload" -e '@.module' 2>/dev/null)"
				action="$(jsonfilter -s "$payload" -e '@.action' 2>/dev/null)"
				confirmation="$(jsonfilter -s "$payload" -e '@.confirmation' 2>/dev/null)"
				[ "$module" = "docker" ] || {
					printf '%s\n' '{ "accepted": false, "error": "Неизвестный модуль" }'
					exit 1
				}
				exec /usr/libexec/nanopi-control/modules-control start "$action" "$confirmation"
				;;
			update_check)
				exec /usr/libexec/nanopi-control/update-control check
				;;
			update_status)
				exec /usr/libexec/nanopi-control/update-control status
				;;
			update_start)
				exec /usr/libexec/nanopi-control/update-control start
				;;
			*)
				printf '%s\n' '{ "error": "Method not found" }'
				exit 1
				;;
		esac
		;;
	*)
		exit 1
		;;
esac
