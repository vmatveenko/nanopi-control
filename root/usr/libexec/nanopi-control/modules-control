#!/bin/sh

RUNTIME_DIR="/tmp/nanopi-control"
STATE_FILE="$RUNTIME_DIR/modules.json"
PID_FILE="$RUNTIME_DIR/modules.pid"
LOCK_DIR="$RUNTIME_DIR/modules.lock"
WORKER="/usr/libexec/nanopi-control/modules-worker"
XUI_MARKER="/etc/nanopi-control/3x-ui-installed"
XUI_DATA_DIR="/opt/3x-ui"
XUI_CONTAINER="3x-ui"
VAULTWARDEN_MARKER="/etc/nanopi-control/vaultwarden-installed"
VAULTWARDEN_DATA_DIR="/opt/vaultwarden"
VAULTWARDEN_CONTAINER="vaultwarden"
VAULTWARDEN_PORT=8000
CADDY_MARKER="/etc/nanopi-control/caddy-installed"
CADDY_DATA_DIR="/opt/caddy"
CADDY_CONTAINER="caddy"
MIN_FREE_KIB=524288

. /usr/share/libubox/jshn.sh

mkdir -p "$RUNTIME_DIR"

package_installed() {
	apk info -e "$1" >/dev/null 2>&1
}

docker_installed() {
	package_installed dockerd &&
		package_installed docker &&
		package_installed docker-compose &&
		package_installed luci-app-dockerman &&
		package_installed luci-i18n-dockerman-ru
}

docker_running() {
	[ -x /etc/init.d/dockerd ] && /etc/init.d/dockerd running >/dev/null 2>&1
}

docker_enabled() {
	[ -x /etc/init.d/dockerd ] && /etc/init.d/dockerd enabled >/dev/null 2>&1
}

docker_ready() {
	docker_installed && docker_running && docker info >/dev/null 2>&1
}

xui_container_exists() {
	docker_ready && docker container inspect "$XUI_CONTAINER" >/dev/null 2>&1
}

xui_running() {
	[ "$(docker container inspect -f '{{.State.Running}}' "$XUI_CONTAINER" 2>/dev/null)" = "true" ]
}

xui_has_data() {
	[ -d "$XUI_DATA_DIR/db" ] || [ -d "$XUI_DATA_DIR/cert" ]
}

xui_managed() {
	xui_container_exists || xui_has_data || [ -e "$XUI_MARKER" ]
}

sync_xui_marker() {
	if xui_container_exists; then
		mkdir -p "${XUI_MARKER%/*}"
		: > "$XUI_MARKER"
	elif docker_ready && [ -e "$XUI_MARKER" ] && ! xui_has_data; then
		rm -f "$XUI_MARKER"
	fi
}

vaultwarden_container_exists() {
	docker_ready && docker container inspect "$VAULTWARDEN_CONTAINER" >/dev/null 2>&1
}

vaultwarden_running() {
	[ "$(docker container inspect -f '{{.State.Running}}' "$VAULTWARDEN_CONTAINER" 2>/dev/null)" = "true" ]
}

vaultwarden_has_data() {
	[ -d "$VAULTWARDEN_DATA_DIR" ] && [ -n "$(ls -A "$VAULTWARDEN_DATA_DIR" 2>/dev/null)" ]
}

vaultwarden_managed() {
	vaultwarden_container_exists || vaultwarden_has_data || [ -e "$VAULTWARDEN_MARKER" ]
}

sync_vaultwarden_marker() {
	if vaultwarden_container_exists; then
		mkdir -p "${VAULTWARDEN_MARKER%/*}"
		: > "$VAULTWARDEN_MARKER"
	elif docker_ready && [ -e "$VAULTWARDEN_MARKER" ] && ! vaultwarden_has_data; then
		rm -f "$VAULTWARDEN_MARKER"
	fi
}

free_kib() {
	df -Pk / 2>/dev/null | awk 'NR == 2 { print $4 + 0 }'
}

xui_default_port_in_use() {
	command -v ss >/dev/null 2>&1 || return 1
	ss -lnt 2>/dev/null | awk 'NR > 1 { address = $4; sub(/^.*:/, "", address); if (address == "2053") found = 1 } END { exit !found }'
}

vaultwarden_port_in_use() {
	if command -v ss >/dev/null 2>&1; then
		ss -lnt 2>/dev/null | awk -v port="$VAULTWARDEN_PORT" 'NR > 1 { address = $4; sub(/^.*:/, "", address); if (address == port) found = 1 } END { exit !found }'
	elif command -v netstat >/dev/null 2>&1; then
		netstat -lnt 2>/dev/null | awk -v port="$VAULTWARDEN_PORT" 'NR > 2 { address = $4; sub(/^.*:/, "", address); if (address == port) found = 1 } END { exit !found }'
	else
		return 1
	fi
}

caddy_container_exists() {
	docker_ready && docker container inspect "$CADDY_CONTAINER" >/dev/null 2>&1
}

caddy_running() {
	[ "$(docker container inspect -f '{{.State.Running}}' "$CADDY_CONTAINER" 2>/dev/null)" = "true" ]
}

caddy_has_data() {
	[ -d "$CADDY_DATA_DIR" ] && [ -n "$(ls -A "$CADDY_DATA_DIR" 2>/dev/null)" ]
}

caddy_managed() {
	caddy_container_exists || caddy_has_data || [ -e "$CADDY_MARKER" ]
}

sync_caddy_marker() {
	if caddy_container_exists; then
		mkdir -p "${CADDY_MARKER%/*}"
		: > "$CADDY_MARKER"
	elif docker_ready && [ -e "$CADDY_MARKER" ] && ! caddy_has_data; then
		rm -f "$CADDY_MARKER"
	fi
}

add_job() {
	local running status module action percent message error success detail
	local current_bytes total_bytes speed_bytes_per_second started_at elapsed_seconds updated_at

	json_add_object job
	if [ -r "$STATE_FILE" ]; then
		running="$(jsonfilter -i "$STATE_FILE" -e '@.running' 2>/dev/null)"
		status="$(jsonfilter -i "$STATE_FILE" -e '@.status' 2>/dev/null)"
		module="$(jsonfilter -i "$STATE_FILE" -e '@.module' 2>/dev/null)"
		action="$(jsonfilter -i "$STATE_FILE" -e '@.action' 2>/dev/null)"
		percent="$(jsonfilter -i "$STATE_FILE" -e '@.percent' 2>/dev/null)"
		message="$(jsonfilter -i "$STATE_FILE" -e '@.message' 2>/dev/null)"
		error="$(jsonfilter -i "$STATE_FILE" -e '@.error' 2>/dev/null)"
		success="$(jsonfilter -i "$STATE_FILE" -e '@.success' 2>/dev/null)"
		detail="$(jsonfilter -i "$STATE_FILE" -e '@.detail' 2>/dev/null)"
		current_bytes="$(jsonfilter -i "$STATE_FILE" -e '@.current_bytes' 2>/dev/null)"
		total_bytes="$(jsonfilter -i "$STATE_FILE" -e '@.total_bytes' 2>/dev/null)"
		speed_bytes_per_second="$(jsonfilter -i "$STATE_FILE" -e '@.speed_bytes_per_second' 2>/dev/null)"
		started_at="$(jsonfilter -i "$STATE_FILE" -e '@.started_at' 2>/dev/null)"
		elapsed_seconds="$(jsonfilter -i "$STATE_FILE" -e '@.elapsed_seconds' 2>/dev/null)"
		updated_at="$(jsonfilter -i "$STATE_FILE" -e '@.updated_at' 2>/dev/null)"
		case "$current_bytes" in ''|*[!0-9]*) current_bytes=0 ;; esac
		case "$total_bytes" in ''|*[!0-9]*) total_bytes=0 ;; esac
		case "$speed_bytes_per_second" in ''|*[!0-9]*) speed_bytes_per_second=0 ;; esac
		case "$started_at" in ''|*[!0-9]*) started_at=0 ;; esac
		case "$elapsed_seconds" in ''|*[!0-9]*) elapsed_seconds=0 ;; esac
		case "$updated_at" in ''|*[!0-9]*) updated_at=0 ;; esac
		[ "$running" = "true" ] && json_add_boolean running 1 || json_add_boolean running 0
		[ "$success" = "true" ] && json_add_boolean success 1 || json_add_boolean success 0
		json_add_string status "${status:-idle}"
		json_add_string module "${module:-docker}"
		json_add_string action "${action:-}"
		json_add_int percent "${percent:-0}"
		json_add_string message "${message:-}"
		json_add_string error "${error:-}"
		json_add_string detail "${detail:-}"
		json_add_int current_bytes "$current_bytes"
		json_add_int total_bytes "$total_bytes"
		json_add_int speed_bytes_per_second "$speed_bytes_per_second"
		json_add_int started_at "$started_at"
		json_add_int elapsed_seconds "$elapsed_seconds"
		json_add_int updated_at "$updated_at"
	else
		json_add_boolean running 0
		json_add_boolean success 0
		json_add_string status idle
		json_add_string module ""
		json_add_string action ""
		json_add_int percent 0
		json_add_string message ""
		json_add_string error ""
		json_add_string detail ""
		json_add_int current_bytes 0
		json_add_int total_bytes 0
		json_add_int speed_bytes_per_second 0
		json_add_int started_at 0
		json_add_int elapsed_seconds 0
		json_add_int updated_at 0
	fi
	json_close_object
}

add_docker_module() {
	local installed="$1" running="$2" enabled="$3" can_install="$4" can_remove="$5" reason="$6" xui_installed="$7" vaultwarden_installed="$8" caddy_installed="$9"

	json_add_object ""
	json_add_string id docker
	json_add_string name Docker
	json_add_boolean installed "$installed"
	json_add_boolean service_running "$running"
	json_add_boolean service_enabled "$enabled"
	json_add_boolean can_install "$can_install"
	json_add_boolean can_remove "$can_remove"
	json_add_string blocked_reason "$reason"
	json_add_array dependencies
	json_close_array
	json_add_array missing_dependencies
	json_close_array
	json_add_array dependents
	[ "$xui_installed" -eq 1 ] && json_add_string "" "3x-ui"
	[ "$vaultwarden_installed" -eq 1 ] && json_add_string "" "Vaultwarden"
	[ "$caddy_installed" -eq 1 ] && json_add_string "" "Caddy"
	json_close_array
	json_close_object
}

add_caddy_module() {
	local installed="$1" running="$2" can_install="$3" can_remove="$4" reason="$5" docker_installed_state="$6"

	json_add_object ""
	json_add_string id caddy
	json_add_string name Caddy
	json_add_boolean installed "$installed"
	json_add_boolean service_running "$running"
	json_add_boolean service_enabled "$installed"
	json_add_boolean can_install "$can_install"
	json_add_boolean can_remove "$can_remove"
	json_add_string blocked_reason "$reason"
	json_add_array dependencies
	json_add_string "" Docker
	json_close_array
	json_add_array missing_dependencies
	[ "$docker_installed_state" -ne 1 ] && json_add_string "" Docker
	json_close_array
	json_add_array dependents
	json_close_array
	json_close_object
}

add_vaultwarden_module() {
	local installed="$1" running="$2" can_install="$3" can_remove="$4" reason="$5" docker_installed_state="$6"

	json_add_object ""
	json_add_string id vaultwarden
	json_add_string name Vaultwarden
	json_add_boolean installed "$installed"
	json_add_boolean service_running "$running"
	json_add_boolean service_enabled "$installed"
	json_add_boolean can_install "$can_install"
	json_add_boolean can_remove "$can_remove"
	json_add_string blocked_reason "$reason"
	json_add_array dependencies
	json_add_string "" Docker
	json_close_array
	json_add_array missing_dependencies
	[ "$docker_installed_state" -ne 1 ] && json_add_string "" Docker
	json_close_array
	json_add_array dependents
	json_close_array
	json_close_object
}

add_xui_module() {
	local installed="$1" running="$2" can_install="$3" can_remove="$4" reason="$5" docker_installed_state="$6"

	json_add_object ""
	json_add_string id 3x-ui
	json_add_string name 3x-ui
	json_add_boolean installed "$installed"
	json_add_boolean service_running "$running"
	json_add_boolean service_enabled "$installed"
	json_add_boolean can_install "$can_install"
	json_add_boolean can_remove "$can_remove"
	json_add_string blocked_reason "$reason"
	json_add_array dependencies
	json_add_string "" Docker
	json_close_array
	json_add_array missing_dependencies
	[ "$docker_installed_state" -ne 1 ] && json_add_string "" Docker
	json_close_array
	json_add_array dependents
	json_close_array
	json_close_object
}

status() {
	local docker_is_installed=0 docker_is_running=0 docker_is_enabled=0
	local docker_api_ready=0
	local docker_can_install=0 docker_can_remove=0 docker_reason=""
	local xui_is_installed=0 xui_is_running=0 xui_can_install=0 xui_can_remove=0 xui_reason=""
	local xui_has_data_state=0 xui_container_state=""
	local vaultwarden_is_installed=0 vaultwarden_is_running=0 vaultwarden_can_install=0 vaultwarden_can_remove=0 vaultwarden_reason=""
	local vaultwarden_has_data_state=0 vaultwarden_container_state=""
	local caddy_is_installed=0 caddy_is_running=0 caddy_can_install=0 caddy_can_remove=0 caddy_reason=""
	local caddy_has_data_state=0 caddy_container_state=""
	local free

	docker_installed && docker_is_installed=1
	docker_running && docker_is_running=1
	docker_enabled && docker_is_enabled=1
	if [ "$docker_is_installed" -eq 1 ] && [ "$docker_is_running" -eq 1 ] && docker info >/dev/null 2>&1; then
		docker_api_ready=1
		xui_container_state="$(docker container inspect -f '{{.State.Running}}' "$XUI_CONTAINER" 2>/dev/null)"
		vaultwarden_container_state="$(docker container inspect -f '{{.State.Running}}' "$VAULTWARDEN_CONTAINER" 2>/dev/null)"
		caddy_container_state="$(docker container inspect -f '{{.State.Running}}' "$CADDY_CONTAINER" 2>/dev/null)"
	fi

	[ -n "$xui_container_state" ] && xui_is_installed=1
	[ "$xui_container_state" = "true" ] && xui_is_running=1
	xui_has_data && xui_has_data_state=1
	if [ "$xui_is_installed" -eq 1 ] || [ "$xui_has_data_state" -eq 1 ] || [ -e "$XUI_MARKER" ]; then
		xui_can_remove=1
	fi
	if [ "$xui_is_installed" -eq 1 ]; then
		mkdir -p "${XUI_MARKER%/*}"
		: > "$XUI_MARKER"
	elif [ "$docker_api_ready" -eq 1 ] && [ -e "$XUI_MARKER" ] && [ "$xui_has_data_state" -ne 1 ]; then
		rm -f "$XUI_MARKER"
	fi

	[ -n "$vaultwarden_container_state" ] && vaultwarden_is_installed=1
	[ "$vaultwarden_container_state" = "true" ] && vaultwarden_is_running=1
	vaultwarden_has_data && vaultwarden_has_data_state=1
	if [ "$vaultwarden_is_installed" -eq 1 ] || [ "$vaultwarden_has_data_state" -eq 1 ] || [ -e "$VAULTWARDEN_MARKER" ]; then
		vaultwarden_can_remove=1
	fi
	if [ "$vaultwarden_is_installed" -eq 1 ]; then
		mkdir -p "${VAULTWARDEN_MARKER%/*}"
		: > "$VAULTWARDEN_MARKER"
	elif [ "$docker_api_ready" -eq 1 ] && [ -e "$VAULTWARDEN_MARKER" ] && [ "$vaultwarden_has_data_state" -ne 1 ]; then
		rm -f "$VAULTWARDEN_MARKER"
	fi

	[ -n "$caddy_container_state" ] && caddy_is_installed=1
	[ "$caddy_container_state" = "true" ] && caddy_is_running=1
	caddy_has_data && caddy_has_data_state=1
	if [ "$caddy_is_installed" -eq 1 ] || [ "$caddy_has_data_state" -eq 1 ] || [ -e "$CADDY_MARKER" ]; then
		caddy_can_remove=1
	fi
	if [ "$caddy_is_installed" -eq 1 ]; then
		mkdir -p "${CADDY_MARKER%/*}"
		: > "$CADDY_MARKER"
	elif [ "$docker_api_ready" -eq 1 ] && [ -e "$CADDY_MARKER" ] && [ "$caddy_has_data_state" -ne 1 ]; then
		rm -f "$CADDY_MARKER"
	fi

	free="$(free_kib)"
	case "$free" in ''|*[!0-9]*) free=0 ;; esac

	if [ "$docker_is_installed" -eq 1 ]; then
		docker_can_remove=1
	elif [ "$(uname -m)" != "aarch64" ]; then
		docker_reason="Docker доступен только для архитектуры aarch64"
	elif [ "$free" -lt "$MIN_FREE_KIB" ]; then
		docker_reason="Недостаточно места: требуется не менее 512 МиБ свободного пространства"
	else
		docker_can_install=1
	fi

	if [ "$caddy_is_installed" -eq 1 ]; then
		:
	elif [ "$caddy_has_data_state" -eq 1 ] || [ -e "$CADDY_MARKER" ]; then
		caddy_reason="Обнаружены данные незавершённой установки; удалите модуль для полного сброса"
	elif [ "$docker_is_installed" -ne 1 ]; then
		caddy_reason="Сначала установите Docker"
	elif [ "$docker_api_ready" -ne 1 ]; then
		caddy_reason="Служба Docker не запущена"
	elif [ "$(uname -m)" != "aarch64" ]; then
		caddy_reason="Caddy доступен только для архитектуры aarch64"
	elif [ "$free" -lt "$MIN_FREE_KIB" ]; then
		caddy_reason="Недостаточно места: требуется не менее 512 МиБ свободного пространства"
	else
		caddy_can_install=1
	fi

	if [ "$vaultwarden_is_installed" -eq 1 ]; then
		:
	elif [ "$vaultwarden_has_data_state" -eq 1 ] || [ -e "$VAULTWARDEN_MARKER" ]; then
		vaultwarden_reason="Обнаружены данные незавершённой установки; удалите модуль для полного сброса"
	elif [ "$docker_is_installed" -ne 1 ]; then
		vaultwarden_reason="Сначала установите Docker"
	elif [ "$docker_api_ready" -ne 1 ]; then
		vaultwarden_reason="Служба Docker не запущена"
	elif [ "$(uname -m)" != "aarch64" ]; then
		vaultwarden_reason="Vaultwarden доступен только для архитектуры aarch64"
	elif [ "$free" -lt "$MIN_FREE_KIB" ]; then
		vaultwarden_reason="Недостаточно места: требуется не менее 512 МиБ свободного пространства"
	elif vaultwarden_port_in_use; then
		vaultwarden_reason="Порт Vaultwarden $VAULTWARDEN_PORT уже занят"
	else
		vaultwarden_can_install=1
	fi

	if [ "$xui_is_installed" -eq 1 ]; then
		:
	elif [ "$xui_has_data_state" -eq 1 ] || [ -e "$XUI_MARKER" ]; then
		xui_reason="Обнаружены данные незавершённой установки; удалите модуль для полного сброса"
	elif [ "$docker_is_installed" -ne 1 ]; then
		xui_reason="Сначала установите Docker"
	elif [ "$docker_api_ready" -ne 1 ]; then
		xui_reason="Служба Docker не запущена"
	elif [ "$(uname -m)" != "aarch64" ]; then
		xui_reason="3x-ui доступен только для архитектуры aarch64"
	elif [ "$free" -lt "$MIN_FREE_KIB" ]; then
		xui_reason="Недостаточно места: требуется не менее 512 МиБ свободного пространства"
	elif xui_default_port_in_use; then
		xui_reason="Порт панели 2053 уже занят"
	else
		xui_can_install=1
	fi

	json_init
	json_add_array modules
	add_docker_module "$docker_is_installed" "$docker_is_running" "$docker_is_enabled" "$docker_can_install" "$docker_can_remove" "$docker_reason" "$xui_is_installed" "$vaultwarden_is_installed" "$caddy_is_installed"
	add_xui_module "$xui_is_installed" "$xui_is_running" "$xui_can_install" "$xui_can_remove" "$xui_reason" "$docker_is_installed"
	add_vaultwarden_module "$vaultwarden_is_installed" "$vaultwarden_is_running" "$vaultwarden_can_install" "$vaultwarden_can_remove" "$vaultwarden_reason" "$docker_is_installed"
	add_caddy_module "$caddy_is_installed" "$caddy_is_running" "$caddy_can_install" "$caddy_can_remove" "$caddy_reason" "$docker_is_installed"
	json_close_array
	add_job
	json_dump
}

start_job() {
	local module="$1" action="$2" confirmation="$3" free

	if [ -d "$LOCK_DIR" ]; then
		printf '%s\n' '{ "accepted": false, "error": "Операция с модулями уже выполняется" }'
		exit 1
	fi

	case "$module:$action" in
		docker:install)
			if docker_installed; then
				printf '%s\n' '{ "accepted": false, "error": "Docker уже установлен" }'
				exit 1
			fi
			if [ "$(uname -m)" != "aarch64" ]; then
				printf '%s\n' '{ "accepted": false, "error": "Неподдерживаемая архитектура" }'
				exit 1
			fi
			free="$(free_kib)"
			case "$free" in ''|*[!0-9]*) free=0 ;; esac
			if [ "$free" -lt "$MIN_FREE_KIB" ]; then
				printf '%s\n' '{ "accepted": false, "error": "Недостаточно свободного места" }'
				exit 1
			fi
			;;
		docker:remove)
			if [ "$confirmation" != "REMOVE_DOCKER_ALL" ]; then
				printf '%s\n' '{ "accepted": false, "error": "Удаление Docker и зависимых модулей не подтверждено" }'
				exit 1
			fi
			if ! docker_installed; then
				printf '%s\n' '{ "accepted": false, "error": "Docker не установлен" }'
				exit 1
			fi
			;;
		3x-ui:install)
			docker_ready || {
				printf '%s\n' '{ "accepted": false, "error": "Docker не установлен или не запущен" }'
				exit 1
			}
			if xui_managed; then
				printf '%s\n' '{ "accepted": false, "error": "3x-ui уже установлен или обнаружены сохранённые данные" }'
				exit 1
			fi
			if xui_default_port_in_use; then
				printf '%s\n' '{ "accepted": false, "error": "Порт панели 2053 уже занят" }'
				exit 1
			fi
			;;
		3x-ui:remove)
			if [ "$confirmation" != "REMOVE_3X_UI" ]; then
				printf '%s\n' '{ "accepted": false, "error": "Удаление 3x-ui не подтверждено" }'
				exit 1
			fi
			if ! xui_managed; then
				printf '%s\n' '{ "accepted": false, "error": "3x-ui не установлен" }'
				exit 1
			fi
			;;
		vaultwarden:install)
			docker_ready || {
				printf '%s\n' '{ "accepted": false, "error": "Docker не установлен или не запущен" }'
				exit 1
			}
			if vaultwarden_managed; then
				printf '%s\n' '{ "accepted": false, "error": "Vaultwarden уже установлен или обнаружены сохранённые данные" }'
				exit 1
			fi
			if vaultwarden_port_in_use; then
				printf '%s\n' '{ "accepted": false, "error": "Порт Vaultwarden 8000 уже занят" }'
				exit 1
			fi
			;;
		vaultwarden:remove)
			if [ "$confirmation" != "REMOVE_VAULTWARDEN" ]; then
				printf '%s\n' '{ "accepted": false, "error": "Удаление Vaultwarden не подтверждено" }'
				exit 1
			fi
			if ! vaultwarden_managed; then
				printf '%s\n' '{ "accepted": false, "error": "Vaultwarden не установлен" }'
				exit 1
			fi
			;;
		caddy:install)
			docker_ready || {
				printf '%s\n' '{ "accepted": false, "error": "Docker не установлен или не запущен" }'
				exit 1
			}
			if caddy_managed; then
				printf '%s\n' '{ "accepted": false, "error": "Caddy уже установлен или обнаружены сохранённые данные" }'
				exit 1
			fi
			;;
		caddy:remove)
			if [ "$confirmation" != "REMOVE_CADDY" ]; then
				printf '%s\n' '{ "accepted": false, "error": "Удаление Caddy не подтверждено" }'
				exit 1
			fi
			if ! caddy_managed; then
				printf '%s\n' '{ "accepted": false, "error": "Caddy не установлен" }'
				exit 1
			fi
			;;
		*)
			printf '%s\n' '{ "accepted": false, "error": "Неизвестное действие" }'
			exit 1
			;;
	esac

	if ! mkdir "$LOCK_DIR"; then
		printf '%s\n' '{ "accepted": false, "error": "Не удалось заблокировать операцию" }'
		exit 1
	fi
	if ! start-stop-daemon -S -b -m -p "$PID_FILE" -x "$WORKER" -- "$module" "$action"; then
		rmdir "$LOCK_DIR" 2>/dev/null || true
		printf '%s\n' '{ "accepted": false, "error": "Не удалось запустить операцию" }'
		exit 1
	fi
	printf '%s\n' '{ "accepted": true }'
}

case "$1" in
	status) status ;;
	sync-menu) sync_xui_marker; sync_vaultwarden_marker; sync_caddy_marker ;;
	start) start_job "$2" "$3" "$4" ;;
	*)
		printf '%s\n' '{ "error": "Неизвестная команда управления модулями" }'
		exit 1
		;;
esac
