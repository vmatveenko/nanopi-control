#!/bin/sh

TAG="${1:-}"
RUNTIME_DIR="/tmp/nanopi-control"
STATE_FILE="$RUNTIME_DIR/update.json"
PID_FILE="$RUNTIME_DIR/update.pid"
LOCK_DIR="$RUNTIME_DIR/update.lock"
WORK_DIR="$RUNTIME_DIR/update-download"
LOG_FILE="$RUNTIME_DIR/update.log"
VERSION_FILE="/usr/share/nanopi-control/version"
DEFAULT_REPOSITORY="vmatveenko/nanopi-control"
FINISHED=0

. /usr/share/libubox/jshn.sh

mkdir -p "$RUNTIME_DIR"
: > "$LOG_FILE"
exec >> "$LOG_FILE" 2>&1

log() {
	printf '%s %s\n' "$(date -Iseconds)" "$*"
}

repository() {
	uci -q get nanopi-control.main.repository 2>/dev/null || printf '%s' "$DEFAULT_REPOSITORY"
}

current_version() {
	if [ -r "$VERSION_FILE" ]; then
		read -r version < "$VERSION_FILE"
		printf '%s' "$version"
	else
		printf '0.0.0'
	fi
}

write_state() {
	local status="$1" available="$2" latest="$3" percent="$4" message="$5" error="$6"
	local tmp="$STATE_FILE.tmp.$$"

	json_init
	json_add_string status "$status"
	json_add_boolean update_available "$available"
	json_add_string current_version "$(current_version)"
	json_add_string latest_version "${latest#v}"
	json_add_string tag "$latest"
	json_add_string repository "$(repository)"
	json_add_int percent "$percent"
	json_add_string message "$message"
	json_add_string error "$error"
	json_add_string log_path "$LOG_FILE"
	json_add_int updated_at "$(date +%s)"
	json_dump > "$tmp"
	mv "$tmp" "$STATE_FILE"
}

fail() {
	log "ERROR: $1"
	write_state error 1 "$TAG" 100 "Обновление завершилось с ошибкой" "$1. Журнал: $LOG_FILE"
	FINISHED=1
	exit 1
}

cleanup() {
	local rc=$?
	rm -f "$PID_FILE"
	rmdir "$LOCK_DIR" >/dev/null 2>&1 || true
	if [ "$rc" -ne 0 ] && [ "$FINISHED" -ne 1 ]; then
		log "ERROR: unexpected worker failure (exit $rc)"
		write_state error 1 "$TAG" 100 "Обновление завершилось с ошибкой" "Непредвиденная ошибка обработчика. Журнал: $LOG_FILE"
	fi
}
trap cleanup EXIT INT TERM

[ -n "$TAG" ] || fail "Не указан тег релиза"
repo="$(repository)"
base="https://github.com/$repo/releases/download/$TAG"
expected_version="${TAG#v}"

log "Starting NanoPi Control update to $TAG from $repo"
rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR" || fail "Не удалось подготовить временный каталог"
write_state downloading 1 "$TAG" 10 "Загрузка контрольных сумм" ""

uclient-fetch -q -T 30 -U "NanoPi-Control/$(current_version)" -O "$WORK_DIR/SHA256SUMS" "$base/SHA256SUMS" || fail "Не удалось загрузить SHA256SUMS"
write_state downloading 1 "$TAG" 25 "Загрузка пакета NanoPi Control" ""
uclient-fetch -q -T 60 -U "NanoPi-Control/$(current_version)" -O "$WORK_DIR/luci-app-nanopi-control.apk" "$base/luci-app-nanopi-control.apk" || fail "Не удалось загрузить пакет NanoPi Control"

write_state downloading 1 "$TAG" 40 "Загрузка русского перевода" ""
if uclient-fetch -q -T 60 -U "NanoPi-Control/$(current_version)" -O "$WORK_DIR/luci-i18n-nanopi-control-ru.apk" "$base/luci-i18n-nanopi-control-ru.apk"; then
	has_translation=1
else
	has_translation=0
	rm -f "$WORK_DIR/luci-i18n-nanopi-control-ru.apk"
	log "Translation package is unavailable; continuing without it"
fi

write_state verifying 1 "$TAG" 55 "Проверка контрольных сумм" ""
(
	cd "$WORK_DIR" || exit 1
	grep '  luci-app-nanopi-control.apk$' SHA256SUMS | sha256sum -c -
) || fail "Контрольная сумма пакета NanoPi Control не совпадает"

if [ "$has_translation" -eq 1 ]; then
	(
		cd "$WORK_DIR" || exit 1
		grep '  luci-i18n-nanopi-control-ru.apk$' SHA256SUMS | sha256sum -c -
	) || fail "Контрольная сумма пакета перевода не совпадает"
fi

write_state installing 1 "$TAG" 70 "Установка пакетов NanoPi Control" ""
if [ "$has_translation" -eq 1 ]; then
	apk --allow-untrusted add "$WORK_DIR/luci-app-nanopi-control.apk" "$WORK_DIR/luci-i18n-nanopi-control-ru.apk" || fail "apk не смог установить обновление"
else
	apk --allow-untrusted add "$WORK_DIR/luci-app-nanopi-control.apk" || fail "apk не смог установить обновление"
fi

installed_version="$(current_version)"
[ "$installed_version" = "$expected_version" ] || fail "После установки ожидалась версия $expected_version, обнаружена $installed_version"

write_state restarting 1 "$TAG" 90 "Обновление служб и кэшей LuCI" ""
/etc/init.d/nanopi-control enable >/dev/null 2>&1 || true
/etc/init.d/nanopi-control restart >/dev/null 2>&1 || true
rm -f /tmp/luci-indexcache /tmp/luci-indexcache.*
rm -rf /tmp/luci-modulecache
write_state complete 0 "$TAG" 100 "NanoPi Control успешно обновлён" ""
log "NanoPi Control update to $TAG completed successfully"
FINISHED=1
sync

(
	sleep 2
	/etc/init.d/rpcd restart
	/etc/init.d/uhttpd restart
) >/dev/null 2>&1 &
