{
	"luci-app-nanopi-control": {
		"description": "Grant access to NanoPi Control status information",
		"read": {
			"ubus": {
				"nanopi-control": [ "status", "migration_preflight", "migration_status", "update_check", "update_status" ],
				"network.interface": [ "dump" ],
				"system": [ "board", "info" ]
			}
		},
		"write": {
			"ubus": {
				"nanopi-control": [ "migration_start", "migration_expand", "migration_erase", "update_start" ]
			}
		}
	}
}
