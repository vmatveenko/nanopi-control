{
	"luci-app-nanopi-control": {
		"description": "Grant access to NanoPi Control status information",
		"read": {
			"ubus": {
				"nanopi-control": [ "status", "migration_preflight", "migration_status", "sd_expand_info", "sd_expand_status", "modules_status", "update_check", "update_status" ],
				"network.interface": [ "dump" ],
				"system": [ "board", "info" ]
			}
		},
		"write": {
			"ubus": {
				"nanopi-control": [ "migration_start", "migration_confirm_boot", "migration_expand", "migration_erase", "sd_expand_start", "modules_start", "update_start" ]
			}
		}
	}
}
