{
	"luci-app-nanopi-control": {
		"description": "Grant access to WrtPilot status information",
		"read": {
			"ubus": {
				"nanopi-control": [ "status", "migration_preflight", "migration_status", "sd_expand_info", "sd_expand_status", "modules_status", "xui_status", "xui_settings", "vaultwarden_status", "caddy_status", "update_check", "update_status" ],
				"network.interface": [ "dump" ],
				"system": [ "board", "info" ]
			}
		},
		"write": {
			"ubus": {
				"nanopi-control": [ "migration_start", "migration_confirm_boot", "migration_expand", "migration_erase", "sd_expand_start", "modules_start", "xui_settings_save", "xui_panel_save", "xui_token_issue", "xui_password_reset", "xui_routing_set", "xui_action", "vaultwarden_action", "caddy_action", "update_start" ]
			}
		}
	}
}
