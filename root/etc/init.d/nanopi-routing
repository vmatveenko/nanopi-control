#!/bin/sh /etc/rc.common
USE_PROCD=1
START=18
STOP=90

start_service() {
	mkdir -p /tmp/nanopi-control
	# Install the fail-closed guard synchronously before network startup.
	/usr/libexec/nanopi-control/routing-worker guard || return 1
	procd_open_instance
	procd_set_param command /usr/libexec/nanopi-control/routing-worker run
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 5
	procd_close_instance
}
